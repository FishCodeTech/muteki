{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=db:5432;Database=gzctf;Username=postgres;Password=__GZCTF_DATABASE_PASSWORD__",
    "Storage": "disk://path=./files"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "EmailConfig": {
    "SenderAddress": "",
    "SenderName": "",
    "UserName": "",
    "Password": "",
    "Smtp": {
      "Host": "localhost",
      "Port": 587
    }
  },
  "XorKey": "__GZCTF_XOR_KEY__",
  "ContainerProvider": {
    "Type": "Docker",
    "PortMappingType": "Default",
    "EnableTrafficCapture": false,
    "PublicEntry": "127.0.0.1",
    "DockerConfig": {
      "Uri": "unix:///var/run/docker.sock",
      "ChallengeNetwork": "muteki-m6-gzctf-challenge"
    }
  },
  "CaptchaConfig": {
    "Provider": "None"
  },
  "DisableRateLimit": false
}
