{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sync_cursor": { "type": "string" },
    "active_instances": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "addrs": { "type": "array", "items": { "type": "string" } },
          "address_fingerprint": { "type": "string" },
          "challenge_key": { "type": "string" },
          "connection_id": { "type": "string" },
          "container_status": { "type": "string" },
          "generation": { "type": "integer", "minimum": 1 },
          "lease_id": { "type": "string" },
          "observed_at": { "type": "number" },
          "started_at": { "type": "number" }
        }
      }
    },
    "environment_sequences": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "run_clocks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["started_at", "ends_at", "duration_seconds", "source"],
        "properties": {
          "started_at": { "type": "string" },
          "ends_at": { "type": "string" },
          "duration_seconds": { "type": "integer", "const": 21600 },
          "source": { "type": "string" }
        }
      }
    },
    "submissions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "before_correct_flags": { "type": "integer", "minimum": 0 },
          "challenge_key": { "type": "string" },
          "connection_id": { "type": "string" },
          "created_at": { "type": "number" },
          "digest": { "type": "string" },
          "result": { "type": "object" },
          "state": { "type": "string" },
          "submission_id": { "type": "string" },
          "updated_at": { "type": "number" }
        }
      }
    }
  }
}
